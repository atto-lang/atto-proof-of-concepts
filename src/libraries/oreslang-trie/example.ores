// oreslang-trie: Digit trie single-path exact match.
// UNVERIFIED: narrow deterministic behavioral probe/reference model only.
// Not a complete library, a borrow/GC proof, or a concurrency verification.
fnc probe(): int {
  val Array<int> digits=new Array<int>();digits.add(4);digits.add(2);digits.add(7);
  let int key=427;
  let int divisor=100;
  for let i=0;i<3;i++ do if digits.get(i)!=(key/divisor)%10 then return 0;fi
  divisor=divisor/10;
  done
  return 1;
}

pub routine main(): void {
  if probe() != 1 then
    stdio.stdout.println("FAIL:oreslang-trie:1");
    return;
  fi
  stdio.stdout.println("PASS:oreslang-trie");
  return;
}
