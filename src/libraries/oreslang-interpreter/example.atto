// oreslang-interpreter: Stack-based arithmetic evaluator model.
// UNVERIFIED: narrow deterministic behavioral probe/reference model only.
// Not a complete library, a borrow/GC proof, or a concurrency verification.
fnc probe(): int {
  val Array<int> s=new Array<int>(); s.add(6); s.add(7);
  let int product=s.get(0)*s.get(1); s.set(0,product); s.add(2);
  if s.get(0)+s.get(2)!=44 then return 0; fi
  return 1;
}

pub routine main(): void {
  if probe() != 1 then
    stdio.stdout.println("FAIL:oreslang-interpreter:1");
    return;
  fi
  stdio.stdout.println("PASS:oreslang-interpreter");
  return;
}
