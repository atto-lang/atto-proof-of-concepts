// Pattern 8: composite.
// Prototype: compiler and runtime results have not been verified in this repo.
// Flat-index tree recursive Composite traversal; pointer-based node graph is the next ownership stress level.

fnc subtree_sum(Array<int> nodes, int index): int {
  if index >= 7 then
    return 0;
  fi
  return nodes.get(index) + subtree_sum(nodes, 2 * index + 1) + subtree_sum(nodes, 2 * index + 2);
}
fnc composite_sum(): int {
  let Array<int> values = new Array<int>();
  for let i = 1; i <= 7; i++ do
    values.add(i);
  done
  return subtree_sum(values, 0);
}

pub routine main(): void {
  if !(composite_sum() == 28) then
    stdio.stdout.println("FAIL:8:1");
    return;
  fi
  stdio.stdout.println("PASS:8");
  return;
}
