// 76: delivery budget with terminal success and dead-letter entries.
// Sequential in-memory model; broker redelivery is outside this sample.
define class DeadLetterRouter as
  val Array<int> active_ids = new Array<int>();
  val Array<int> attempts = new Array<int>();
  val Array<int> dead_ids = new Array<int>();
  val Array<int> done_ids = new Array<int>();
  let int active_count = 0;
  let int dead_count = 0;
  let int done_count = 0;

  // 0=retry, 1=delivered, 2=dead-lettered.
  pub deliver(mut self)(int id, bool success): int {
    for let i = 0; i < self.dead_count; i++ do
      if self.dead_ids.get(i) == id then return 2; fi
    done
    for let i = 0; i < self.done_count; i++ do
      if self.done_ids.get(i) == id then return 1; fi
    done
    if success then
      self.done_ids.add(id);
      self.done_count = self.done_count + 1;
      return 1;
    fi
    for let i = 0; i < self.active_count; i++ do
      if self.active_ids.get(i) == id then
        val int count = self.attempts.get(i) + 1;
        self.attempts.set(i, count);
        if count >= 3 then
          self.dead_ids.add(id);
          self.dead_count = self.dead_count + 1;
          return 2;
        fi
        return 0;
      fi
    done
    self.active_ids.add(id);
    self.attempts.add(1);
    self.active_count = self.active_count + 1;
    return 0;
  }

  pub dead_letters(): int { return self.dead_count; }
  pub completed(): int { return self.done_count; }
end

pub routine main(): void {
  val DeadLetterRouter router = new DeadLetterRouter();
  if router.deliver(10, false) != 0 then
    stdio.stdout.println("FAIL:76:1"); return;
  fi
  if router.deliver(10, false) != 0 then
    stdio.stdout.println("FAIL:76:2"); return;
  fi
  if router.deliver(10, false) != 2 then
    stdio.stdout.println("FAIL:76:3"); return;
  fi
  if router.deliver(10, true) != 2 then
    stdio.stdout.println("FAIL:76:4"); return;
  fi
  if router.deliver(20, true) != 1 then
    stdio.stdout.println("FAIL:76:5"); return;
  fi
  if router.deliver(21, false) != 0 then
    stdio.stdout.println("FAIL:76:6"); return;
  fi
  if router.deliver(21, true) != 1 then
    stdio.stdout.println("FAIL:76:7"); return;
  fi
  if router.deliver(20, false) != 1 then
    stdio.stdout.println("FAIL:76:8"); return;
  fi
  if router.dead_letters() != 1 then
    stdio.stdout.println("FAIL:76:9"); return;
  fi
  if router.completed() != 2 then
    stdio.stdout.println("FAIL:76:10"); return;
  fi
  stdio.stdout.println("PASS:76");
  return;
}
