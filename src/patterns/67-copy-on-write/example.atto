// Pattern 67: copy-on-write.
// Status: source prototype; not verified on Java or LLVM.
// Copy-before-mutation reference behavior; automatic COW refcounts not implemented.

fnc copy_on_write_model(): int {
  val Array<int> shared = new Array<int>();
  shared.add(5);
  shared.add(6);
  val Array<int> detached = new Array<int>();
  detached.add(shared.get(0));
  detached.add(shared.get(1));
  detached.set(0, 99);
  return shared.get(0) * 100 + detached.get(0);
}

pub routine main(): void {
  if !(copy_on_write_model() == 599) then
    stdio.stdout.println("FAIL:67:1");
    return;
  fi
  stdio.stdout.println("PASS:67");
  return;
}
