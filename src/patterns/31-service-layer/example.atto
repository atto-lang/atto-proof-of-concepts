// Pattern 31: service-layer.
// Prototype: compiler and runtime results have not been verified in this repo.
// Domain service coordinates validation and account update.

fnc validate(int amount): bool { return And(amount > 0, amount <= 100); }
fnc service(int current, int amount): int {
  if !validate(amount) then
    return -1;
  fi
  return current + amount;
}

pub routine main(): void {
  if !(service(10, 7) == 17) then
    stdio.stdout.println("FAIL:31:1");
    return;
  fi
  if !(service(10, -2) == -1) then
    stdio.stdout.println("FAIL:31:2");
    return;
  fi
  stdio.stdout.println("PASS:31");
  return;
}
