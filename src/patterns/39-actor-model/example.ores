// Private actor declaration using current Java source grammar.
// Executed main tests serialized mailbox arithmetic; actor scheduler
// execution exclusivity remains a separate runtime/model-check obligation.
actor CounterActor {
  let int count = 0;
  pub increment(mut self)(int amount): int {
    self.count = self.count + amount;
    return self.count;
  }
  pub snapshot(): int {
    return self.count;
  }
}

fnc serial_mailbox_model(): int {
  let int count = 0;
  val Array<int> mailbox = new Array<int>();
  mailbox.add(2);
  mailbox.add(3);
  mailbox.add(-1);
  for let i = 0; i < 3; i++ do
    count = count + mailbox.get(i);
  done
  return count;
}

pub routine main(): void {
  if serial_mailbox_model() != 4 then
    stdio.stdout.println("FAIL:39:1");
    return;
  fi
  stdio.stdout.println("PASS:39");
  return;
}
