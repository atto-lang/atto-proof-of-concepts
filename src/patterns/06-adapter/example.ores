// Pattern 6: adapter.
// Prototype: compiler and runtime results have not been verified in this repo.
// Adapts Fahrenheit input to Celsius-consuming API.

// Preconditions: numerator >= 0 and divisor > 0. Uses integer-only arithmetic
// because Java-tip currently evaluates '/' as float even for int operands.
fnc quotient_nonnegative(int numerator, int divisor): int {
  if divisor <= 0 then return -1; fi
  if numerator < 0 then return -1; fi
  if numerator < divisor then return 0; fi
  return 1 + quotient_nonnegative(numerator - divisor, divisor);
}
fnc fahrenheit_to_celsius(int f): int { return quotient_nonnegative((f - 32) * 5, 9); }
fnc adapter(int temperature_f): int { return fahrenheit_to_celsius(temperature_f); }

pub routine main(): void {
  if !(adapter(212) == 100) then
    stdio.stdout.println("FAIL:6:1");
    return;
  fi
  if !(adapter(32) == 0) then
    stdio.stdout.println("FAIL:6:2");
    return;
  fi
  if !(adapter(50) == 10) then
    stdio.stdout.println("FAIL:6:3");
    return;
  fi
  stdio.stdout.println("PASS:6");
  return;
}
