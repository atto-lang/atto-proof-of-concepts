// Pattern 50: specification.
// Status: source prototype; not verified on Java or LLVM.
// Boolean predicate composition with lexical closures.

fnc satisfies(int value, Fnc<bool(int)> first, Fnc<bool(int)> second): bool {
  return And(first(value), second(value));
}
fnc specification_model(int value): bool {
  val Fnc<bool(int)> positive = |int n| -> { return n > 0; };
  val Fnc<bool(int)> even = |int n| -> { return n % 2 == 0; };
  return satisfies(value, positive, even);
}

pub routine main(): void {
  if !(specification_model(8)) then
    stdio.stdout.println("FAIL:50:1");
    return;
  fi
  if !(!specification_model(7)) then
    stdio.stdout.println("FAIL:50:2");
    return;
  fi
  if !(!specification_model(-2)) then
    stdio.stdout.println("FAIL:50:3");
    return;
  fi
  stdio.stdout.println("PASS:50");
  return;
}
