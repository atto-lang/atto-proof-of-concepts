// Pattern 26: repository.
// Prototype: compiler and runtime results have not been verified in this repo.
// In-memory repository backed by explicit key/value arrays.

fnc find(Array<int> keys, Array<int> values, int key): int {
  for let i = 0; i < 3; i++ do
    if keys.get(i) == key then
      return values.get(i);
    fi
  done
  return -1;
}
fnc repository(): int {
  val Array<int> k = new Array<int>();
  val Array<int> v = new Array<int>();
  k.add(1); k.add(2); k.add(3);
  v.add(10); v.add(20); v.add(30);
  return find(k, v, 2);
}

pub routine main(): void {
  if !(repository() == 20) then
    stdio.stdout.println("FAIL:26:1");
    return;
  fi
  stdio.stdout.println("PASS:26");
  return;
}
